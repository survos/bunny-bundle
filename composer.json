{
    "name": "survos/bunny-bundle",
    "description": "Symfony bundle for interacting with BunnyCDN using https://github.com/ToshY/BunnyNet-PHP",
    "keywords": [
        "symfony-ux",
        "symfony"
    ],
    "license": "MIT",
    "type": "symfony-bundle",
    "require": {
        "php": "^8.5",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-kernel": "^8.1",
        "twig/twig": "^3.4",
        "toshy/bunnynet-php": "^8.0|^9.0",
        "zenstruck/bytes": "^1.0",
        "symfony/console": "^8.1",
        "symfony/http-client-contracts": "^3.6"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2.0",
        "symfony/browser-kit": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/var-dumper": "^8.1",
        "survos/simple-datatables-bundle": "^2.5",
        "symfony/yaml": "^8.1",
        "symfony/http-client": "^8.1",
        "phpunit/phpunit": "^13.0",
        "knplabs/knp-time-bundle": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Survos\\BunnyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Survos\\BunnyBundle\\Tests\\": "Tests/"
        }
    },
    "suggest": {
        "survos/simple-datatables-bundle": "searchable/sortable tables when browsing"
    }
}
